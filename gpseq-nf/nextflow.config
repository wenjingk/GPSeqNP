// Top-level Nextflow config for the GPSeq pipeline.
//
// PATHS ASSUME THE PUBLISHED LAYOUT: this pipeline lives in gpseq-nf/ inside the GPSeqNP
// repository, so the GPSeqNP scripts and masking files are one level up at ../scripts and
// ../masking_files. All four are params — override on the command line if you have the
// pipeline and the scripts somewhere else.

manifest {
    name            = 'gpseq-nf'
    author          = 'CNATrace / BiCroLab'
    description     = 'GPSeq preprocessing (BAMs+BEDs) + centrality score via gpseq-radical.R'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04'
    version         = '0.2.0'
}

params {
    // === User-supplied (CLI) ===
    samplesheet     = null                                              // path to samplesheet.csv
    outdir          = "${projectDir}/results"                           // per-run subdirs created beneath

    // === Reference cache (shared across runs) ===
    // Bowtie2 index + cut-site BED get built once per (ref_genome, ref_version, enzyme) combo
    // and reused thereafter. Defaults to the symlink under tools/.
    ref_dir         = "${projectDir}/../ref"                            // built here on first run
    mask_dir        = "${projectDir}/../masking_files"                  // tracked at repo root
    gpseqnp_scripts = "${projectDir}/../scripts"                        // the GPSeqNP scripts
    radical_script  = "${projectDir}/tools/GPSeq-RadiCal/gpseq-radical.R"

    // === Asset tables (build/enzyme defaults) ===
    genomes_csv     = "${projectDir}/assets/genomes.csv"
    enzymes_csv     = "${projectDir}/assets/enzymes.csv"

    // === gpseq-radical.R defaults (overridable per samplesheet row) ===
    default_bins         = '1e6:1e5,5e5:5e4,1e5:1e4,5e4:5e4,25e3:25e3'
    default_normalize_by = 'lib'
    default_umi_length   = 8

    // === Resources ===
    max_cpus    = 24
    max_memory  = '60 GB'
    max_time    = '120.h'
}

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) -v ' + projectDir + '/../scripts:/home/scripts:ro'
        singularity.enabled    = false
        process.container      = 'wenjingk/gpseq:latest'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process.container      = "${projectDir}/tools/gpseq.sif"
    }
    test {
        // Cap resources for smoke runs / CI
        params.max_cpus   = 4
        params.max_memory = '12 GB'
        params.max_time   = '4.h'
    }
}

process {
    cpus   = { Math.min(params.max_cpus as int, 8) }
    memory = { '8 GB' }
    time   = { '24.h' }

    withName: GPSEQ_MAP {
        cpus   = { Math.min(params.max_cpus as int, 8) }
        // 48 GB (was 16 GB): step 10 `umi_dedupl.R -c 8 -r 10000` forks 8 R workers
        // whose combined RSS OOM-killed the container at the 16 GB cgroup cap
        // (run 3, 2026-05-23) — and that kill happened with workers still ramping,
        // so true peak is well above 16 GB. 48 GB gives margin and caps local
        // concurrency at 2 samples on the 125 GB box, easing host pressure.
        memory = { '48 GB' }
        time   = { '12.h' }
    }
    withName: GPSEQ_RADICAL {
        cpus   = { Math.min(params.max_cpus as int, 6) }
        memory = { '24 GB' }
        time   = { '6.h' }
    }
    withName: GPSEQ_SUMMARY {
        cpus   = 1
        memory = { '2 GB' }
        time   = { '30.m' }
    }
}

// Capture run info
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
